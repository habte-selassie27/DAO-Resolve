# DAOResolve environment template
# Copy to .env and fill values locally. Never commit .env.

# Built-in GenLayer network name (for example: studionet).
# Select it with: genlayer network set <network>
GENLAYER_NETWORK=

# Deployment account. Leave blank in this template.
# Never commit a real private key or seed phrase.
GENLAYER_PRIVATE_KEY=

# Optional external evidence fetch settings.
EVIDENCE_FETCH_TIMEOUT_SECONDS=

# DAOResolve contract address for scripts and the recorder.
CONTRACT_ADDRESS=

# Recorder key for the submit command only. Never commit a real key.
RECORDER_PRIVATE_KEY=
