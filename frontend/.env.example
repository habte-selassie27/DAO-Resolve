# Public configuration only. Never put a private key in the frontend.
VITE_NETWORK=studionet
VITE_CONTRACT_ADDRESS=0x151af6e00e1250Af44B8be1a14eb743C9613A41A
VITE_STUDIO_URL=/api
# 1 = fixtures + simulated transactions, 0 = deployed contract
VITE_MOCK=0
# The contract has no list_proposals view; these ids are opened one by one.
VITE_PROPOSAL_IDS=P1,P2,P3,P4,P5,ENS-7.1
# Curated cases shown on the overview.
VITE_DEMO_DISPUTES=D1,D4,D3
